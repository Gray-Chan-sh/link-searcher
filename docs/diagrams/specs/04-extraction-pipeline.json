    { "from": "router", "to": "audio", "label": ".mp3/.wav" },
    { "from": "router", "to": "text", "label": ".txt/.md/.csv" },
    { "from": "router", "to": "archive", "label": ".zip/.tar" },
    { "from": "pdf", "to": "hash", "label": "提取文本" },
    { "from": "office", "to": "hash", "label": "提取文本" },
    { "from": "image", "to": "hash", "label": "OCR 文本" },
    { "from": "audio", "to": "hash", "label": "转写文本" },
    { "from": "text", "to": "hash", "label": "直接文本" },
    { "from": "archive", "to": "hash", "label": "解包文本" },
    { "from": "hash", "to": "textOut", "label": "去重后", "variant": "emphasis" }
