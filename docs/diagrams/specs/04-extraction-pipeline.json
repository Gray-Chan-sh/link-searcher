  "cards": [
    { "dot": "cyan", "title": "格式路由", "items": ["按扩展名自动分发", "新增格式只需加提取器", "主流程不变"] },
    { "dot": "emerald", "title": "去重设计", "items": ["MD5 内容哈希去重", "相同内容只提取一次", "后续文件复用索引"] },
    { "dot": "amber", "title": "OCR 多引擎", "items": ["内置 PaddleOCR 优先", "系统原生引擎降级", "Tesseract 备选"] }
