    { "id": "pdf", "lane": "extract", "col": 2, "type": "backend", "label": "PDF 提取", "sublabel": "文本抽取 / OCR", "yOffset": -150 },
    { "id": "office", "lane": "extract", "col": 2, "type": "backend", "label": "Office 提取", "sublabel": "Word/Excel/PPT 原生", "yOffset": -75 },
    { "id": "image", "lane": "extract", "col": 2, "type": "backend", "label": "图片 OCR", "sublabel": "PaddleOCR", "yOffset": 0 },
    { "id": "audio", "lane": "extract", "col": 2, "type": "backend", "label": "音频转写", "sublabel": "FunASR 语音识别", "yOffset": 75 },
    { "id": "text", "lane": "extract", "col": 2, "type": "backend", "label": "纯文本", "sublabel": "直接读取", "yOffset": 225 },
    { "id": "archive", "lane": "extract", "col": 2, "type": "backend", "label": "压缩包", "sublabel": "解包后逐条目", "yOffset": 150 },
    { "id": "hash", "lane": "output", "col": 3, "type": "database", "label": "内容哈希", "sublabel": "MD5 去重" },
    { "id": "textOut", "lane": "output", "col": 4, "type": "database", "label": "纯文本", "sublabel": "存入索引" }
